# Node.js 24 LTS. Copy to .env on the server; never commit real secrets.
NODE_ENV=production
PORT=4173
APP_ORIGIN=https://foodbusinesscoach.online
DATABASE_PATH=/app/data/fame.sqlite

# PAYMENT MODE:
# 'razorpay': Live/test checkout with real or test Razorpay credentials.
# 'demo': Local simulation only (requires NODE_ENV=development).
PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=rzp_test_or_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# EMAIL (SMTP) CONFIGURATION:
# Required in production for account verification and password reset links.
# Examples: Amazon SES, SendGrid, Brevo, Postmark, Google Workspace / Gmail.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# Entire value must be wrapped in quotes if containing spaces/brackets:
MAIL_FROM="FAME <support@foodbusinesscoach.online>"
# Or simply:
# MAIL_FROM=support@foodbusinesscoach.online

# REVERSE PROXY:
# Set to 1 because Nginx is proxying requests to this container.
TRUST_PROXY_HOPS=1

# SUPPORT & BUSINESS SETTINGS:
SUPPORT_EMAIL=support@foodbusinesscoach.online
