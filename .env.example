# Node.js 24 LTS. Copy to .env on the server; never commit real secrets.
NODE_ENV=production
PORT=4173
APP_ORIGIN=https://foodbusinesscoach.online
DATABASE_PATH=/app/data/fame.sqlite

# PAYMENT MODE:
# 'razorpay': Live/test checkout with real or test Razorpay credentials.
# 'demo': Local simulation only (requires NODE_ENV=development).
PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# EMAIL (SMTP & BREVO) CONFIGURATION:
# Configured for Brevo (formerly Sendinblue) SMTP Relay:
# 1. Host: smtp-relay.brevo.com (Port 465, secure: true)
# 2. User: Your Brevo SMTP Login (e.g. a69439001@smtp-brevo.com)
# 3. Pass: Your Brevo SMTP Master Key (from app.brevo.com -> SMTP & API)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=a69439001@smtp-brevo.com
SMTP_PASS=your_brevo_smtp_master_key
MAIL_FROM="Manmath Biradar <mentor@foodbusinesscoach.online>"

# REVERSE PROXY:
# Set to 1 because Nginx is proxying requests to this container.
TRUST_PROXY_HOPS=1

# SUPPORT & BUSINESS SETTINGS:
SUPPORT_EMAIL=support@foodbusinesscoach.online
