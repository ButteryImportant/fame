# Node.js 24 LTS. Copy to .env; never commit real secrets.
NODE_ENV=development
PORT=4173
APP_ORIGIN=http://localhost:4173
DATABASE_PATH=./data/fame.sqlite
# demo: local simulation only. razorpay: actual Razorpay test/live checkout.
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Production requires working SMTP for verification and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Only set to 1 behind exactly one trusted reverse proxy. Never use true.
TRUST_PROXY_HOPS=0
# Development email links are written to data/mail-preview.jsonl (local only).
# Optional support email, also editable through Owner > Settings.
SUPPORT_EMAIL=
